# Secretos
.env
*.env
!.env.example

# Datos de los contenedores (base de datos de Zabbix)
zabbix/data/

# Wazuh: datos de los contenedores y certificados TLS generados
wazuh/data/
wazuh/config/certs/

# GLPI: datos de los contenedores (Fase 11)
tickets/data/

# OPNsense: snapshots sin sanitizar (si backup-config.sh falla a mitad de
# camino); los *.xml sanitizados sí se comitean (Fase 11)
iac/opnsense/config-snapshots/*.raw.xml

# Python
__pycache__/
*.pyc

# Archivos del sistema
.DS_Store
Thumbs.db
desktop.ini

# Discos, ISOs y VMs (nunca al repo)
*.iso
*.vmdk
*.vmx
*.vmsd
*.nvram
